PORT=3000
ADMIN_PASSWORD=choose-a-strong-password

# Supabase (or any Postgres) connection string — use the "Transaction pooler" connection
# string from Supabase Project Settings -> Database -> Connection string, so it works
# correctly from short-lived serverless functions.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
