PORT=3000
ADMIN_PASSWORD=choose-a-strong-password

# If deployed via Vercel's native Supabase integration, POSTGRES_URL is injected
# automatically and nothing below is needed. For local dev or a manual Postgres/Supabase
# setup, set DATABASE_URL to the "Transaction pooler" connection string from Supabase
# Project Settings -> Database -> Connection string (port 6543) — the direct connection
# (port 5432) often resolves only over IPv6 and will fail to connect.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
